            self.toggle_video_viewer_playback();
            return;
        }

        if self.show_record_review_panel {
            if !ctx.input_mut(|input| input.consume_key(egui::Modifiers::NONE, egui::Key::Space)) {
                return;
            }
            let Some(sound) = self
                .recording_draft
                .as_ref()
                .map(|draft| draft.sound.clone())
            else {
